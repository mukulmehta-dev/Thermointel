# ThermoIntel - Frontend Environment Variables Example
# Copy this file to .env and configure as needed

# CARTO basemaps API key (optional - basemaps load with or without key)
VITE_CARTO_API_KEY=your_carto_api_key_here

# ThermoIntel Backend API URL (default: http://127.0.0.1:8001)
VITE_API_URL=http://127.0.0.1:8001
